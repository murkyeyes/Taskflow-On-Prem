# Copy this file to backup/.env. Never commit backup/.env.
# Get the Session pooler URI from Supabase Dashboard -> Connect.
# Percent-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PERCENT_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Local or protected synced destination. The script creates it when missing.
BACKUP_DIR=D:\CompanyBackups\Supabase

# Files strictly older than this many days are deleted only after a verified backup.
RETENTION_DAYS=30

# Produces company_db_YYYY-MM-DD_HH-mm.dump.
BACKUP_PREFIX=company_db

# Taskflow application tables are in public. Avoid dumping Supabase internal schemas.
PG_SCHEMA=public

# Optional when pg_dump/pg_restore are already on PATH. Client major version must be
# equal to or newer than the Supabase PostgreSQL server major version.
PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
