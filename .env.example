NODE_ENV=development
PORT=3000
# Production Supabase URLs must include sslmode=require (or verify-full with its CA).
DATABASE_URL=postgres://taskflow:change_me@localhost:5432/taskflow
JWT_SECRET=replace_with_at_least_32_random_characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Leave COOKIE_DOMAIN blank for a host-only api.example.com cookie.
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
HOST_FINGERPRINT=
LICENSE_KEY=
